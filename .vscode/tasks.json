{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "pub get: logic",
      "type": "shell",
      "command": "dart pub get",
      "options": { "cwd": "${workspaceFolder}/logic" },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "pub get: server",
      "type": "shell",
      "command": "dart pub get",
      "options": { "cwd": "${workspaceFolder}/server" },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "pub get: ui",
      "type": "shell",
      "command": "flutter pub get",
      "options": { "cwd": "${workspaceFolder}/ui" },
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "pub get: all",
      "dependsOn": ["pub get: logic", "pub get: server", "pub get: ui"],
      "dependsOrder": "parallel",
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "firefox: 1 client",
      "type": "shell",
      "command": "firefox --new-window http://localhost:7001",
      "presentation": { "reveal": "never" }
    },
    {
      "label": "firefox: 2 clients",
      "type": "shell",
      "command": "firefox --new-window http://localhost:7001 --new-tab http://localhost:7002",
      "presentation": { "reveal": "never" }
    },
    {
      "label": "firefox: 3 clients",
      "type": "shell",
      "command": "firefox --new-window http://localhost:7001 --new-tab http://localhost:7002 --new-tab http://localhost:7003",
      "presentation": { "reveal": "never" }
    },
    {
      "label": "deploy: remote",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/deploy.sh",
      "presentation": { "reveal": "always", "panel": "dedicated", "focus": true }
    }
  ]
}
